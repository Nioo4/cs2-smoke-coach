{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe": {
      "()": "app.core.logging.SafeJsonFormatter"
    }
  },
  "handlers": {
    "safe": {
      "class": "logging.StreamHandler",
      "formatter": "safe",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["safe"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["safe"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [],
      "level": "CRITICAL",
      "propagate": false
    },
    "alembic": {
      "handlers": ["safe"],
      "level": "INFO",
      "propagate": false
    },
    "sqlalchemy": {
      "handlers": ["safe"],
      "level": "WARNING",
      "propagate": false
    },
    "smokeline": {
      "handlers": ["safe"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["safe"],
    "level": "WARNING"
  }
}
