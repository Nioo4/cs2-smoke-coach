{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smokeline.invalid/schema/query_cases.schema.json",
  "title": "SmokeLine text evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "turns", "expected", "tags"],
  "properties": {
    "id": {"type": "string", "pattern": "^Q[0-9]{3}$"},
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text", "input_mode"],
            "properties": {
              "kind": {"const": "query"},
              "text": {"type": "string", "minLength": 1, "maxLength": 200},
              "input_mode": {"enum": ["text", "voice"]}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "field", "value"],
            "properties": {
              "kind": {"const": "selection"},
              "field": {"const": "target"},
              "value": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
            }
          }
        ]
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_type",
        "target_slug",
        "origin_slug",
        "selected_lineup_id",
        "routes",
        "clarification_field",
        "not_found_reason",
        "llm_calls_max"
      ],
      "properties": {
        "response_type": {
          "enum": ["match", "route_matches", "clarification", "not_found", "out_of_scope"]
        },
        "target_slug": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          ]
        },
        "origin_slug": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          ]
        },
        "selected_lineup_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"}
          ]
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_slug", "origin_slug", "lineup_id"],
            "properties": {
              "target_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "origin_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "lineup_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"}
            }
          }
        },
        "clarification_field": {"anyOf": [{"type": "null"}, {"const": "target"}]},
        "not_found_reason": {"anyOf": [{"type": "null"}, {"enum": ["NO_TARGET", "NO_LOCAL_RESULT"]}]},
        "llm_calls_max": {"type": "integer", "minimum": 0}
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    }
  }
}
